# Copy selected non-secret settings to script-opts/splay.conf if desired.
# splay never writes this file and starts disabled in every new mpv process.
# These are first-run defaults. Saved non-secret history restores the last form.
# History is separate: ~~/splay-history.json.
# Set history_enabled=no to use these defaults on every launch and disable saves.
history_enabled=yes
# Windows current-user DPAPI; separate encrypted file: ~~/splay-credentials.json.
# No passwords belong in this configuration. Disable to use process memory only.
remember_password=yes
host=syncplay.pl
port=8999
username=splayuser
# No automatic room: enter or explicitly select a room before connecting.
room=
tls=prefer
# native uses mp.input; uosc requires separately installed uosc (tested 5.12/5.13).
ui=native
# The ordinary Shift+s binding can be overridden by input.conf.
# Overlay visibility/position (also toggle visibility in the splay menu).
status_osd=yes
button_enabled=yes
# Standalone fallback only; integrated uosc controls use their own layout.
button_bottom=48
button_right=22
overlay_font_size=22
overlay_chat_ttl=5
overlay_chat_lines=4
overlay_message_ttl=5
room_panel=yes
# Fallback when the player does not expose a usable cursor-autohide option.
room_idle_timeout=3
