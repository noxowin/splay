# Copy selected non-secret settings to script-opts/splay.conf if desired.
# splay never writes this file and starts disabled in every new mpv process.
# These are first-run defaults. Saved non-secret history restores the last form.
# History is separate: ~~/splay-history.json.
# Set history_enabled=no to use these defaults on every launch and disable saves.
history_enabled=yes
# Windows current-user DPAPI; separate encrypted file: ~~/splay-credentials.json.
# No passwords belong in this configuration. Disable to use process memory only.
remember_password=yes
# Retry temporary failures only after an explicit connection; never auto-connect on startup.
auto_reconnect=yes
# Display and share server RTT after explicitly enabling splay; peers need reporting support.
latency_enabled=yes
# When 1.5 to 4 s ahead of the room, play at 0.95x until level instead of jumping back.
smooth_catchup=yes
# Apply the five-second all-ready countdown preference after a successful room connection.
autostart_enabled=yes
# Pause the whole room on member departure/join (subject to controller permissions).
# Saved preferences restore the last menu selection.
pause_on_leave=yes
pause_on_join=yes
host=syncplay.pl
port=8999
username=splayuser
# No automatic room: enter or explicitly select a room before connecting.
room=
tls=prefer
# native uses mp.input; uosc requires separately installed uosc (tested 5.12/5.13).
ui=native
# Interface language: auto follows the Windows display language (any Chinese ->
# zh-CN, otherwise en); zh-CN or en fixes it. Settings -> Language switches it at
# runtime; that choice is remembered with history_enabled=yes and then takes precedence.
language=auto
# The ordinary Shift+s binding can be overridden by input.conf.
# Overlay visibility/position (also toggle visibility in the splay menu).
status_osd=yes
button_enabled=yes
# Standalone fallback only; integrated uosc controls use their own layout.
button_bottom=48
button_right=22
overlay_font_size=22
# Scrolling chat only; room messages and member information keep their existing size.
danmaku_font_scale=1.15
overlay_chat_ttl=5
overlay_chat_lines=4
overlay_message_ttl=5
room_panel=yes
# room: colored names in the message area; danmaku: scrolling chat lanes.
# Last menu selection is remembered with history_enabled=yes.
chat_mode=room
# Optional: raise video output cadence for smoother scrolling chat (extra playback load).
# Applies only while splay is enabled in danmaku mode; does not rewrite the user's filter list.
danmaku_smooth=no
# Fallback when the player does not expose a usable cursor-autohide option.
room_idle_timeout=3
