# Copy selected non-secret settings to script-opts/splay.conf if desired.
# splay never writes this file and never connects automatically.
# These are first-run defaults. Saved non-secret history restores the last form.
# History is separate: ~~/splay-history.json.
# Set history_enabled=no to use these defaults on every launch and disable saves.
history_enabled=yes
host=syncplay.pl
port=8999
username=splayuser
room=default
tls=prefer
# native uses mp.input; uosc requires separately installed uosc (tested 5.12/5.13).
ui=native
# The ordinary Shift+s binding can be overridden by input.conf.
# Overlay visibility/position (also toggle visibility in the splay menu).
status_osd=yes
button_enabled=yes
button_bottom=85
overlay_font_size=22
overlay_chat_ttl=12
overlay_chat_lines=4
